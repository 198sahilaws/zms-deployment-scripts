# Normalise line endings across platforms.
# These scripts are authored on Windows but the .sh files execute on Linux:
# a CRLF checkout makes them fail with "/bin/bash^M: bad interpreter".
* text=auto

# Shell scripts must always check out with LF endings.
*.sh  text eol=lf

# PowerShell stays CRLF for Windows tooling.
*.ps1 text eol=crlf
